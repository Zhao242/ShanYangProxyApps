#!name=常用App去广告
#!desc=瑞幸/粉笔/雷达/智慧房东去广告页面优化，Safari重定向。作者:山羊🐐
#!system=ios
#!category=山羊移动端App学习

[URL Rewrite]
#> 瑞幸咖啡
^https:\/\/capi\.lkcoffee\.com\/resource\/m\/eorder\/product\/popAppTagProductList\?sign - reject
^https:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew\?sign - reject

#> 粉笔
# 开屏广告
^https:\/\/tiku\.fenbi\.com\/activity\/app\/launcher - reject
# 首页 - 弹窗
^https:\/\/keapi\.fenbi\.com\/app\/iphone\/\w+\/popup - reject
# 首页 - 新用户注册送好礼全屏弹窗
^https:\/\/market-api\.fenbi\.com\/iphone\/v1\/assistant\/info - reject
# 首页 - 悬浮窗 - 笔面常备资料
^https:\/\/market-api\.fenbi\.com\/iphone\/v1\/assistant\/entrance\/show - reject

#> 公考雷达
^http:\/\/static\.gongkaoleida\.com\/2024\/ad - reject
^https:\/\/api\.gongkaoleida\.com\/api\/v2\/ad\/info - reject

# safari 重定向
^https:\/\/duckduckgo\.com\/\?q=([^&]+).+ https://www.google.com/search?q=$1 307
# Safari google重定向
^https?://(www.)?g.cn https://www.google.com 302
^https?://(www.)?google.cn https://www.google.com 302




# 智慧房东
^https:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/clickPicMore - reject
^https:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/bannerPicMore - reject
^https:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/appOpenAds - reject


[MITM]
hostname = %APPEND% *.lkcoffee.com,*.fenbi.com, *.gongkaoleida.com,duckduckgo.com, *.zhihuifangdong.net,www.google.cn, www.g.cn